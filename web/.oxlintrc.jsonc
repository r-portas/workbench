{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "oxc", "jsdoc", "react", "react-perf", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
  },
  "rules": {
    // verbatimModuleSyntax is off (see tsconfig.json), so enforce `import type` here instead
    "typescript/consistent-type-imports": "error",
    // Prefer undefined over null
    "unicorn/no-null": "error",
    // Not needed for React 17+
    "react/react-in-jsx-scope": "off",
    // TanStack splat routes capture the rest of the path as `_splat`
    "eslint/no-underscore-dangle": ["error", { "allow": ["_splat"] }],
  },
  "settings": {
    "jsdoc": {
      "tagNamePreference": {
        "remarks": "remarks",
      },
    },
  },
}
