        "sesame-oil",
        "soy-sauce",
        "rice-vinegar-sauce",
        "avocado-oil-sauce",
        "red-pepper-flakes"
      ]
    },
    {
      "text": "Slice the cucumber, toss the rice with rice wine vinegar, slice the avocado, and shred the romaine.",
      "ingredientIds": ["cucumber", "rice", "rice-vinegar-rice", "avocado", "romaine"]
    },
    {
      "text": "Assemble 6 bowls with rice, cucumber, avocado, romaine, and the cabbage-chicken mixture. Drizzle with the reserved sauce.",
      "ingredientIds": []
    }
