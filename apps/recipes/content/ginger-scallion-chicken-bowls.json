  "steps": [
    {
      "text": "Combine the napa cabbage, purple cabbage, and bell peppers in a large bowl.",
      "ingredientIds": ["napa-cabbage", "purple-cabbage", "yellow-bell-pepper", "red-bell-pepper"]
    },
    {
      "text": "Sauté the mushrooms in avocado oil in a medium skillet until golden brown, 8-10 minutes. Add to the cabbage mixture along with the shredded chicken.",
      "ingredientIds": ["shiitake-mushrooms", "avocado-oil-mushrooms", "rotisserie-chicken"]
    },
    {
      "text": "Combine the scallions, ginger, garlic, sesame oil, soy sauce, rice vinegar, avocado oil, and red pepper flakes for the sauce. Reserve half for drizzling and toss the rest with the cabbage and chicken mixture.",
      "ingredientIds": [
        "scallions",
