{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["vite/client", "bun"],
    "paths": { "@/*": ["./src/*"] },

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // TanStack Start keeps server code out of the client bundle by relying on TypeScript erasing
    // type-only imports. verbatimModuleSyntax preserves them instead, which leaks server modules
    // into the client bundle, so it must stay off. The
    // typescript/consistent-type-imports rule in .oxlintrc.jsonc enforces `import type` instead
    "verbatimModuleSyntax": false,
    // verbatimModuleSyntax would normally imply isolatedModules, so it has to be set directly
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "vite.config.ts"]
}
